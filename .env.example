# Local development only. Replace all placeholder credentials before deployment.
POSTGRES_DB=knowbridge
POSTGRES_USER=knowbridge
POSTGRES_PASSWORD=local-dev-change-me
KNOWBRIDGE_DB_USER=knowbridge_app
KNOWBRIDGE_DB_PASSWORD=local-app-db-change-me

# Host URLs for standalone processes. Compose supplies service hostnames.
# The API uses the non-superuser role so PostgreSQL row-level security is active.
KNOWBRIDGE_DATABASE_URL=postgresql+psycopg://knowbridge_app:local-app-db-change-me@localhost:5432/knowbridge
KNOWBRIDGE_REDIS_URL=redis://localhost:6379/0
KNOWBRIDGE_ENVIRONMENT=development
KNOWBRIDGE_LOG_LEVEL=INFO
KNOWBRIDGE_JWT_SECRET_KEY=local-dev-only-secret-change-before-deploy-please
KNOWBRIDGE_ACCESS_TOKEN_EXPIRE_MINUTES=30
KNOWBRIDGE_RATE_LIMIT_PER_MINUTE=120
KNOWBRIDGE_AUTH_RATE_LIMIT_PER_MINUTE=10
KNOWBRIDGE_CORS_ORIGINS='["http://localhost:3000"]'

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
